Project BIGMARKET {
  database_type: 'PostgreSQL'
  Note: 'BIGMARKET 대형 중고품 거래 플랫폼 ERD'
}


// ======================================================
// ENUM
// ======================================================

Enum user_status {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

Enum oauth_provider {
  GOOGLE
  NAVER
  KAKAO
}

Enum item_condition {
  NEW
  USED
  DAMAGED
}

Enum item_sale_status {
  ON_SALE
  RESERVED
  SOLD
}

Enum transaction_status {
  PAYMENT_PENDING
  SELLER_CONFIRMING
  TRANSPORT_RESERVED
  COMPLETED
  CANCELLED
  REFUNDED
  DISPUTED
}

Enum payment_provider {
  NAVER_PAY
  KAKAO_PAY
  TOSS_PAY
  OTHER
}

Enum payment_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

Enum reservation_status {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

Enum message_type {
  TEXT
  IMAGE
  LOCATION
  SYSTEM
}

Enum notification_type {
  CHAT_MESSAGE
  PRICE_CHANGED
  TRANSACTION_CHANGED
  KEYWORD_MATCHED
  RESERVATION_CHANGED
}

Enum report_type {
  USER
  ITEM
  MESSAGE
}

Enum report_status {
  RECEIVED
  REVIEWING
  RESOLVED
  REJECTED
}

Enum media_type {
  IMAGE
  VIDEO
}


// ======================================================
// 1. 회원
// ======================================================

Table users {
  user_id bigint [pk, increment]

  login_id varchar(50) [unique, not null]
  password_hash varchar(255)

  nickname varchar(50) [unique, not null]
  profile_image_url varchar(500)

  phone_number varchar(20) [unique]

  status user_status [not null, default: 'ACTIVE']

  nickname_changed_at timestamp

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Note: '''
  회원 기본 정보.
  - 아이디/닉네임 중복 불가
  - 닉네임은 3개월에 한 번 변경
  - 탈퇴 후 30일 재가입 제한은 서비스 로직에서 검증
  '''
}


// ======================================================
// 2. OAuth 계정
// ======================================================

Table oauth_accounts {
  oauth_account_id bigint [pk, increment]

  user_id bigint [not null]

  provider oauth_provider [not null]
  provider_user_id varchar(255) [not null]

  created_at timestamp [not null, default: `now()`]

  indexes {
    (provider, provider_user_id) [unique]
    (user_id, provider) [unique]
  }

  Note: 'Google / Naver / Kakao OAuth 2.0 계정 연동'
}


// ======================================================
// 3. 사용자 차단
// ======================================================

Table user_blocks {
  blocker_id bigint [not null]
  blocked_user_id bigint [not null]

  created_at timestamp [not null, default: `now()`]

  indexes {
    (blocker_id, blocked_user_id) [pk]
  }

  Note: '사용자 간 차단 관계'
}


// ======================================================
// 4. 신고
// ======================================================

Table reports {
  report_id bigint [pk, increment]

  reporter_id bigint [not null]

  reported_user_id bigint
  item_id bigint
  message_id bigint

  report_type report_type [not null]

  reason varchar(100) [not null]
  description text

  status report_status [not null, default: 'RECEIVED']

  created_at timestamp [not null, default: `now()`]
  resolved_at timestamp

  Note: '''
  사용자 / 상품 / 메시지 신고.
  report_type에 따라 신고 대상 FK 중 하나를 사용.
  '''
}


// ======================================================
// 5. 카테고리
// ======================================================

Table categories {
  category_id bigint [pk, increment]

  parent_category_id bigint

  name varchar(100) [not null]

  display_order int [default: 0]

  created_at timestamp [not null, default: `now()`]

  Note: '상품 카테고리. parent_category_id를 이용하여 계층 구조 지원'
}


// ======================================================
// 6. 지역
// ======================================================

Table regions {
  region_id bigint [pk, increment]

  parent_region_id bigint

  name varchar(100) [not null]

  latitude decimal(10, 7)
  longitude decimal(10, 7)

  Note: '상품 지역 검색 및 위치 기반 추천에 사용'
}


// ======================================================
// 7. 상품
// ======================================================

Table items {
  item_id bigint [pk, increment]

  seller_id bigint [not null]

  category_id bigint [not null]
  region_id bigint

  title varchar(200) [not null]
  description text [not null]

  condition item_condition [not null]

  price bigint [not null, default: 0]

  sale_status item_sale_status [not null, default: 'ON_SALE']

  transaction_method varchar(50)

  view_count bigint [not null, default: 0]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Note: '''
  판매 상품.
  sale_status:
  - ON_SALE: 판매중
  - RESERVED: 예약중
  - SOLD: 판매완료
  '''
}


// ======================================================
// 8. 상품 이미지 / 동영상
// ======================================================

Table item_media {
  media_id bigint [pk, increment]

  item_id bigint [not null]

  media_type media_type [not null]

  media_url varchar(500) [not null]

  display_order int [not null]

  is_thumbnail boolean [not null, default: false]

  created_at timestamp [not null, default: `now()`]

  indexes {
    (item_id, display_order) [unique]
  }

  Note: '''
  상품 이미지/동영상.
  상품당 최대 10개 제한은 서비스 로직에서 처리.
  첫 번째 미디어를 대표 이미지로 사용할 수 있음.
  '''
}


// ======================================================
// 9. 찜 / 관심상품
// ======================================================

Table favorites {
  user_id bigint [not null]
  item_id bigint [not null]

  created_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, item_id) [pk]
  }

  Note: '사용자와 상품 간 N:M 관심상품 관계'
}


// ======================================================
// 10. 최근 본 상품
// ======================================================

Table item_views {
  item_view_id bigint [pk, increment]

  user_id bigint [not null]
  item_id bigint [not null]

  viewed_at timestamp [not null, default: `now()`]

  indexes {
    (user_id, viewed_at)
    (item_id, viewed_at)
  }

  Note: '최근 본 상품 및 개인화 추천 데이터로 사용'
}


// ======================================================
// 11. 거래
// ======================================================

Table transactions {
  transaction_id bigint [pk, increment]

  item_id bigint [not null]

  seller_id bigint [not null]
  buyer_id bigint [not null]

  status transaction_status [not null, default: 'PAYMENT_PENDING']

  item_price bigint [not null]
  fee_amount bigint [not null, default: 0]
  total_amount bigint [not null]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  completed_at timestamp
  cancelled_at timestamp

  Note: '''
  실제 구매 거래.
  상태 흐름:
  결제대기
  → 판매자 확인
  → 상하차 예약
  → 거래 완료
  '''
}


// ======================================================
// 12. 결제
// ======================================================

Table payments {
  payment_id bigint [pk, increment]

  transaction_id bigint [not null]
  payer_id bigint [not null]

  provider payment_provider [not null]

  amount bigint [not null]
  fee_amount bigint [not null, default: 0]

  status payment_status [not null, default: 'PENDING']

  pg_transaction_id varchar(255)

  created_at timestamp [not null, default: `now()`]
  paid_at timestamp
  refunded_at timestamp

  indexes {
    pg_transaction_id [unique]
  }

  Note: '''
  PG사 / 간편결제 처리.
  네이버페이 / 카카오페이 / 토스페이 등.
  '''
}


// ======================================================
// 13. 상하차 예약
// ======================================================

Table transport_reservations {
  reservation_id bigint [pk, increment]

  transaction_id bigint [not null]

  pickup_address varchar(500) [not null]
  pickup_latitude decimal(10, 7)
  pickup_longitude decimal(10, 7)
  pickup_at timestamp [not null]

  dropoff_address varchar(500) [not null]
  dropoff_latitude decimal(10, 7)
  dropoff_longitude decimal(10, 7)
  dropoff_at timestamp [not null]

  status reservation_status [not null, default: 'PENDING']

  reservation_fee bigint [not null, default: 0]
  cancellation_fee bigint [not null, default: 0]

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]
  cancelled_at timestamp

  Note: '''
  상하차 예약.
  - 상차 시간은 현재 시간 이후
  - 하차 시간은 상차 시간 이후
  '''
}


// ======================================================
// 14. 채팅방
// ======================================================

Table chat_rooms {
  chat_room_id bigint [pk, increment]

  item_id bigint [not null]
  transaction_id bigint

  seller_id bigint [not null]
  buyer_id bigint [not null]

  created_at timestamp [not null, default: `now()`]
  closed_at timestamp

  indexes {
    (item_id, seller_id, buyer_id) [unique]
  }

  Note: '상품 거래 관계를 기반으로 생성되는 1:1 채팅방'
}


// ======================================================
// 15. 메시지
// ======================================================

Table messages {
  message_id bigint [pk, increment]

  chat_room_id bigint [not null]
  sender_id bigint [not null]

  message_type message_type [not null, default: 'TEXT']

  content text

  image_url varchar(500)

  latitude decimal(10, 7)
  longitude decimal(10, 7)
  location_address varchar(500)

  is_read boolean [not null, default: false]

  created_at timestamp [not null, default: `now()`]
  deleted_at timestamp

  Note: '''
  채팅 메시지.
  TEXT / IMAGE / LOCATION / SYSTEM 지원.
  이미지 및 위치는 현재 규모에서는 messages에 통합.
  '''
}


// ======================================================
// 16. 키워드 알림
// ======================================================

Table keyword_alerts {
  keyword_alert_id bigint [pk, increment]

  user_id bigint [not null]

  keyword varchar(100) [not null]

  category_id bigint
  region_id bigint

  min_price bigint
  max_price bigint

  is_active boolean [not null, default: true]

  created_at timestamp [not null, default: `now()`]

  Note: '특정 키워드에 해당하는 신규 상품 알림 설정'
}


// ======================================================
// 17. 알림
// ======================================================

Table notifications {
  notification_id bigint [pk, increment]

  user_id bigint [not null]

  type notification_type [not null]

  title varchar(200) [not null]
  content varchar(500)

  reference_type varchar(50)
  reference_id bigint

  is_read boolean [not null, default: false]

  created_at timestamp [not null, default: `now()`]
  read_at timestamp

  indexes {
    (user_id, is_read, created_at)
  }

  Note: '''
  채팅 / 가격변동 / 거래상태 / 키워드 / 예약 알림.
  reference_type + reference_id로 관련 데이터 연결.
  '''
}


// ======================================================
// RELATIONSHIPS
// ======================================================


// ----------------------
// 회원
// ----------------------

Ref: oauth_accounts.user_id > users.user_id

Ref: user_blocks.blocker_id > users.user_id
Ref: user_blocks.blocked_user_id > users.user_id

Ref: reports.reporter_id > users.user_id
Ref: reports.reported_user_id > users.user_id


// ----------------------
// 카테고리 / 지역
// ----------------------

Ref: categories.parent_category_id > categories.category_id

Ref: regions.parent_region_id > regions.region_id


// ----------------------
// 상품
// ----------------------

Ref: items.seller_id > users.user_id
Ref: items.category_id > categories.category_id
Ref: items.region_id > regions.region_id

Ref: item_media.item_id > items.item_id

Ref: favorites.user_id > users.user_id
Ref: favorites.item_id > items.item_id

Ref: item_views.user_id > users.user_id
Ref: item_views.item_id > items.item_id


// ----------------------
// 거래
// ----------------------

Ref: transactions.item_id > items.item_id
Ref: transactions.seller_id > users.user_id
Ref: transactions.buyer_id > users.user_id

Ref: payments.transaction_id > transactions.transaction_id
Ref: payments.payer_id > users.user_id

Ref: transport_reservations.transaction_id > transactions.transaction_id


// ----------------------
// 채팅
// ----------------------

Ref: chat_rooms.item_id > items.item_id
Ref: chat_rooms.transaction_id > transactions.transaction_id

Ref: chat_rooms.seller_id > users.user_id
Ref: chat_rooms.buyer_id > users.user_id

Ref: messages.chat_room_id > chat_rooms.chat_room_id
Ref: messages.sender_id > users.user_id


// ----------------------
// 신고
// ----------------------

Ref: reports.item_id > items.item_id
Ref: reports.message_id > messages.message_id


// ----------------------
// 키워드 알림
// ----------------------

Ref: keyword_alerts.user_id > users.user_id
Ref: keyword_alerts.category_id > categories.category_id
Ref: keyword_alerts.region_id > regions.region_id


// ----------------------
// 알림
// ----------------------

Ref: notifications.user_id > users.user_id